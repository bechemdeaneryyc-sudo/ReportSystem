rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // The whole register lives in this one document.
    match /parishRegister/main {
      // Anyone signed in (even anonymously, used only to browse the
      // registration screens before someone has an account) can read.
      allow read: if request.auth != null;

      // Only a REAL account (email/password) can write — an anonymous
      // visitor can look, but can never change or wipe the data.
      allow write: if request.auth != null
                   && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
